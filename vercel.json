{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/admin.html", "dest": "/admin.html" },
    { "src": "/CoreTrust_CTC_GEM_Simplified_Guide", "dest": "/CoreTrust_CTC_GEM_Simplified_Guide.html" },
    { "src": "/CoreTrust_CTC_GEM_Simplified_Guide.html", "dest": "/CoreTrust_CTC_GEM_Simplified_Guide.html" },
    { "src": "/CoreTrust-Core", "dest": "/CoreTrust-Core.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/index.html", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
